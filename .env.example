# Supabase public client configuration
# Copy this file to .env for local development and fill with values from the target environment.
# Never commit secret/service-role keys.

SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
SUPABASE_URL=https://your-project-ref.supabase.co

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co


# OAuth redirect after Microsoft Entra ID sign-in.
# Must also be included in Supabase Auth redirect allow list.
# Example local: http://localhost:3000
# Example production: https://your-app.example.com
VITE_AUTH_REDIRECT_URL=http://localhost:3000

# Avisos por e-mail (SAFRA-M05) — configurar como segredos do backend, nunca no código.
# Remetente oficial de todos os avisos: painel.safra@editoradobrasil.com.br (padrão no código).
MS_TENANT_ID=45ba725f-d260-45c3-ac85-11f433471277
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_SENDER=painel.safra@editoradobrasil.com.br
